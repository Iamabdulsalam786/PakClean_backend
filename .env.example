# Pak Clean API – local environment template
# Copy to .env and adjust values. Never commit .env.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=Pak Clean API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# -----------------------------------------------------------------------------
# Server (used later by uvicorn / Docker)
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# -----------------------------------------------------------------------------
# Database (matches docker-compose.yml for local Postgres)
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DB_NAME
# Host is "localhost" when the API runs on your machine and DB in Docker.
# Host becomes "db" only if the API also runs inside Docker Compose.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://pak_clean:pak_clean_secret@localhost:5432/pak_clean

# -----------------------------------------------------------------------------
# Security / JWT
# Generate a long random string for production, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# -----------------------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# -----------------------------------------------------------------------------
# CORS – React Native / admin web origins (comma-separated)
# Expo / Metro often use localhost; add your LAN IP when testing on a phone.
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://127.0.0.1:8081

# -----------------------------------------------------------------------------
# Email / SMTP (Gmail App Password for local development)
# 1) Enable 2-Step Verification on the Google account
# 2) Create an App Password (Google Account → Security → App passwords)
# 3) Paste the 16-character App Password into SMTP_PASSWORD
# Never commit a real .env with your App Password.
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=yourgmail@gmail.com
SMTP_PASSWORD=replace-with-gmail-app-password
EMAIL_FROM=yourgmail@gmail.com
SMTP_USE_TLS=true

# OTP policy
OTP_EXPIRE_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
