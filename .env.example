ENVIRONMENT=development
PORT=8000
API_PREFIX=/api/v1

DATABASE_URL=sqlite+aiosqlite:///./dev.db
# PostgreSQL (production / docker compose):
# DATABASE_URL=postgresql+asyncpg://pakclean:pakclean@localhost:5432/pakclean

JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters-long
JWT_ACCESS_EXPIRES_MINUTES=15
JWT_REFRESH_EXPIRES_DAYS=30
JWT_REFRESH_EXPIRES_DAYS_SHORT=7

OTP_LENGTH=6
OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PakClean <noreply@pakclean.com>

CORS_ORIGINS=*
