# Pak Clean API – local environment template
# Copy to .env and adjust values. Never commit .env.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=Pak Clean API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# -----------------------------------------------------------------------------
# Server (used later by uvicorn / Docker)
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# -----------------------------------------------------------------------------
# Database (matches docker-compose.yml for local Postgres)
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DB_NAME
# Host is "localhost" when the API runs on your machine and DB in Docker.
# Host becomes "db" only if the API also runs inside Docker Compose.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://pak_clean:pak_clean_secret@localhost:5432/pak_clean

# -----------------------------------------------------------------------------
# Security / JWT
# Generate a long random string for production, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# -----------------------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# -----------------------------------------------------------------------------
# CORS – React Native / admin web origins (comma-separated)
# Expo / Metro often use localhost; add your LAN IP when testing on a phone.
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://127.0.0.1:8081

# -----------------------------------------------------------------------------
# Email / SMTP — real OTP delivery
# Set SMTP_ENABLED=true and fill in credentials to send emails.
# Leave disabled for local dev (OTP shows in app + backend logs).
#
# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASSWORD=your-16-char-app-password
#   SMTP_FROM_EMAIL=you@gmail.com
#   SMTP_FROM_NAME=PakClean
#
# SendGrid SMTP example:
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_USER=apikey
#   SMTP_PASSWORD=SG.xxxx
#   SMTP_FROM_EMAIL=noreply@yourdomain.com
# -----------------------------------------------------------------------------
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=PakClean
SMTP_USE_TLS=true

# Email provider: auto | smtp | resend | console
EMAIL_PROVIDER=auto

# Resend (optional — easier than Gmail for dev)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=PakClean
